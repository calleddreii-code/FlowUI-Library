local C = UI.Theme

-- All theme-reactive bindings (closures that read the theme and update visuals)
UI._bindings = {}

function UI._bind(fn)
    table.insert(UI._bindings, fn)
    pcall(fn, C)
    return fn
end

local function applyBlur(enabled)
    local existing = Lighting:FindFirstChild("BulletTrainBlur")
    if enabled then
        if not existing then
            local b = Instance.new("BlurEffect")
            b.Name = "BulletTrainBlur"
            b.Size = 16
            b.Parent = Lighting
        end
    elseif existing then
        existing:Destroy()
    end
end

function UI.SetTheme(name)
    local t = UI.Themes[name]
    if not t then return false end
    UI.ThemeName = name
    for k, v in pairs(t) do UI.Theme[k] = v end
    for _, fn in ipairs(UI._bindings) do pcall(fn, UI.Theme) end
    applyBlur(t.BlurEnabled == true)
    return true
end

function UI.GetTheme()    return UI.ThemeName end
function UI.ToggleTheme() return UI.SetTheme(UI.ThemeName == "default" and "frosted" or "default") end

